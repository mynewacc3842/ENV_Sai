# ─────────────────────────────────────────────────────────────────────────────
# Roblox AI Agent – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────

# The public URL of your deployment (no trailing slash).
# Used for CORS headers and constructing absolute URLs.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────

# Pooled connection string used by the app at runtime (PgBouncer port 6543).
# Format: postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/roblox_ai_dev

# Direct (non-pooled) connection used by Prisma migrations (port 5432).
# Format: postgresql://postgres.[ref]:[password]@[host]:5432/postgres
DIRECT_URL=postgresql://postgres:password@localhost:5432/roblox_ai_dev

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used to sign access JWTs. Minimum 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars

# Secret used to sign refresh JWTs. Use a different value from JWT_SECRET.
# Generate: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars

# ── OpenAI / AI Provider ──────────────────────────────────────────────────────

# OpenAI API key (starts with sk-).
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# Model name to use for AI suggestions (default: gpt-4o).
OPENAI_MODEL=gpt-4o

# Optional: custom base URL for OpenAI-compatible providers (e.g. Azure, Together AI).
# Leave blank to use the default OpenAI endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Redis (optional) ──────────────────────────────────────────────────────────

# Redis connection URL for job queuing and rate limiting.
# If not set, the app uses an in-memory fallback (not suitable for multi-instance).
# Recommended providers: Upstash (serverless) or Railway.
# REDIS_URL=redis://localhost:6379

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Maximum number of AI requests per user per rate-limit window (default: 20).
# RATE_LIMIT_AI_MAX=20

# Rate-limit window duration in milliseconds (default: 60000 = 1 minute).
# RATE_LIMIT_AI_WINDOW_MS=60000
