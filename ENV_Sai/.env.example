# ─── Database (Supabase PostgreSQL + Prisma) ───────────────────────────────────
#
# For Supabase, go to: Project Settings → Database → Connection string
#
# DATABASE_URL  → "Session mode" pooled connection (use for Vercel / serverless)
#   Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL    → Direct (non-pooled) connection (used by Prisma migrations)
#   Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#
# If you only have the direct connection string, you can set both variables to
# the same value for local development:

DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gowcuiwaxygxtmoxfltb.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gowcuiwaxygxtmoxfltb.supabase.co:5432/postgres"

# ─── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── App URL ───────────────────────────────────────────────────────────────────
# For local dev use http://localhost:3000, for production use your Vercel URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Redis (optional) ──────────────────────────────────────────────────────────
# If not set, the app falls back to in-memory job queuing (not suitable for prod)
# REDIS_URL="redis://localhost:6379"
