// Prisma schema for Roblox AI Agent SaaS
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────
// 1) AUTHENTICATION DOMAIN
// ────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  pairingCodes      PairingCode[]
  pluginConnections PluginConnection[]
  projects          Project[]
  aiJobs            AiJob[]

  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ────────────────────────────────────────────
// 2) PLUGIN PAIRING DOMAIN
// ────────────────────────────────────────────

model PairingCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
  @@map("pairing_codes")
}

model PluginConnection {
  id           String   @id @default(cuid())
  userId       String
  machineId    String
  refreshToken String   @unique
  lastSeenAt   DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([refreshToken])
  @@map("plugin_connections")
}

// ────────────────────────────────────────────
// 3) WORKSPACE / PROJECT DOMAIN
// ────────────────────────────────────────────

model Project {
  id        String   @id @default(cuid())
  userId    String
  placeId   BigInt
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  manifests Manifest[]
  patches   Patch[]
  aiJobs    AiJob[]

  @@unique([userId, placeId])
  @@index([userId])
  @@map("projects")
}

model Manifest {
  id        String   @id @default(cuid())
  projectId String
  jsonData  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patches Patch[]
  aiJobs  AiJob[]

  @@index([projectId])
  @@map("manifests")
}

// ────────────────────────────────────────────
// 4) AI SUGGESTION DOMAIN
// ────────────────────────────────────────────

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model AiJob {
  id         String      @id @default(cuid())
  userId     String
  projectId  String
  manifestId String
  prompt     String
  status     AiJobStatus @default(QUEUED)
  result     Json?
  error      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  patches  Patch[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("ai_jobs")
}

// ────────────────────────────────────────────
// 5) PATCH DOMAIN
// ────────────────────────────────────────────

enum PatchStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

model Patch {
  id         String      @id @default(cuid())
  projectId  String
  manifestId String
  aiJobId    String?
  jsonPatch  Json
  summary    String
  status     PatchStatus @default(PENDING)
  deliveredAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  aiJob    AiJob?   @relation(fields: [aiJobId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@map("patches")
}
